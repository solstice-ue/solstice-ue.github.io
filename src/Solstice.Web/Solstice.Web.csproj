<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flare.Blazor" Version="0.44.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3" Version="0.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="WTG.Z.Blazor.Diagrams" Version="4.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solstice.Core\Solstice.Core.csproj" />
  </ItemGroup>

  <!--
    GitHub Pages 没有 SPA 回退：直接访问 /assets 这类客户端路由会 404。
    两条措施：
    1) 把 index.html 复制成 404.html，Pages 用它接住未知路径；
    2) 为每个路由生成 <route>/index.html，让已知路由直接返回 200
       （<base href="/"> 不变，静态资源仍从根加载）。
    都只复制、不维护第二份源码。
  -->
  <ItemGroup>
    <SpaRoute Include="assets;bytecode;graph;ukapi;wasm" />
  </ItemGroup>

  <Target Name="CopySpaFallbackTo404" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/index.html" DestinationFiles="$(PublishDir)wwwroot/404.html" Condition="Exists('$(PublishDir)wwwroot/index.html')" />
    <MakeDir Directories="@(SpaRoute->'$(PublishDir)wwwroot/%(Identity)')" />
    <Copy SourceFiles="@(SpaRoute->'$(PublishDir)wwwroot/index.html')" DestinationFiles="@(SpaRoute->'$(PublishDir)wwwroot/%(Identity)/index.html')" Condition="Exists('$(PublishDir)wwwroot/index.html')" />
  </Target>

</Project>
