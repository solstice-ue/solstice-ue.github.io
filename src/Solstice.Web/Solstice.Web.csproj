<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flare.Blazor" Version="0.44.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3" Version="0.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solstice.Core\Solstice.Core.csproj" />
  </ItemGroup>

  <!--
    GitHub Pages 没有 SPA 回退：直接访问 /assets 这类客户端路由会 404。
    发布时把 index.html 复制成 404.html，Pages 用它接住未知路径，
    应用以原 URL 启动后由 Blazor Router 匹配到正确的页面。
    只复制、不维护第二份源码。
  -->
  <Target Name="CopySpaFallbackTo404" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot/index.html"
          DestinationFiles="$(PublishDir)wwwroot/404.html"
          Condition="Exists('$(PublishDir)wwwroot/index.html')" />
  </Target>

</Project>
