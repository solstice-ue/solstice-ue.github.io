@page "/ukapi"
@using Solstice.Core.Kismet

<PageTitle>Solstice · UKAPI</PageTitle>

<div class="solstice-page" style="max-width:none">
    <div class="solstice-head">
        <h1 class="solstice-h1">UKAPI · 生成</h1>
        <span class="solstice-spacer"></span>
        <span class="solstice-muted">@_instructions.Count 条指令 · @_connections.Count 条连线</span>
    </div>

    <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="AddAssignNode">+ 赋值</FlareButton>
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="AddCallNode">+ 调用</FlareButton>
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="AddReturnNode">+ 返回</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="RemoveLastNode">删除末节点</FlareButton>
    </div>

    <div style="display:grid; grid-template-columns:minmax(300px,1fr) 460px; gap:16px; align-items:start;">

        <FlareCard Style="height:72vh; display:flex; flex-direction:column; overflow:hidden">
            <div class="solstice-card-title">字节码预览（跳转为字节偏移）</div>
            <div style="flex:1; overflow:auto; font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.7;">
                @for (var i = 0; i < _instructions.Count; i++)
                {
                    var ins = _instructions[i];
                    <div style="display:flex; gap:10px; white-space:pre;">
                        <span style="opacity:.45;">@i.ToString("000")</span>
                        <span style="opacity:.55; width:34px;">@ins.TokenHex</span>
                        <span style="color:@OpcodeColor(ins.Opcode); width:190px;">@ins.Opcode</span>
                        <span style="opacity:.7;">@ins.Operand</span>
                        @if (ins.JumpTarget is { } t)
                        {
                            <span style="color:var(--flare-color-tertiary);">→ @t</span>
                        }
                    </div>
                }
            </div>
        </FlareCard>

        <div style="height:72vh; overflow:auto; position:relative;"
             @onmousemove="OnMouseMove" @onmouseup="OnMouseUp">
            <svg width="460" height="@(_nodes.Count * RowHeight)" style="position:absolute; left:0; top:0; pointer-events:none;">
                @foreach (var c in _connections)
                {
                    var a = PinPoint(c.FromNode, c.FromPin);
                    var b = PinPoint(c.ToNode, c.ToPin);
                    <path d="@Curve(a, b)" stroke="@StrokeFor(c)" stroke-width="2" fill="none" />
                }
                @if (_dragFrom is { } df && _dragPos is { } dp)
                {
                    var a = PinPoint(df.Node, df.Pin);
                    <path d="@Curve(a, dp)" stroke="var(--flare-color-primary)" stroke-width="2"
                          stroke-dasharray="4 3" fill="none" />
                }
            </svg>

            @for (var i = 0; i < _nodes.Count; i++)
            {
                var node = _nodes[i];
                var row = i;
                <div style="position:absolute; left:0; top:@(row * RowHeight)px; width:460px; height:@(RowHeight - 8)px;
                            border:1px solid var(--flare-color-outline-variant); border-radius:12px;
                            background:var(--flare-color-surface-container-low);">
                    <div style="padding:6px 16px; font-weight:600; font-size:13px;">@node.Title</div>

                    @for (var p = 0; p < node.Inputs.Count; p++)
                    {
                        var pin = node.Inputs[p];
                        <div style="position:absolute; left:6px; top:@(PinY(p))px; display:flex; align-items:center; gap:8px; font-size:12px;">
                            <span class="pin @PinClass(pin.Type)"
                                  @onmousedown="@(() => StartDrag(node.Id, pin.Id))"
                                  @onmouseup="@(() => EndDrag(node.Id, pin.Id))"></span>
                            <span>@pin.Label</span>
                        </div>
                    }

                    @for (var p = 0; p < node.Outputs.Count; p++)
                    {
                        var pin = node.Outputs[p];
                        <div style="position:absolute; right:6px; top:@(PinY(p))px; display:flex; align-items:center; gap:8px; font-size:12px;">
                            <span>@pin.Label</span>
                            <span class="pin @PinClass(pin.Type)"
                                  @onmousedown="@(() => StartDrag(node.Id, pin.Id))"
                                  @onmouseup="@(() => EndDrag(node.Id, pin.Id))"></span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="solstice-note" style="margin-top:12px">
        从任一插销按住拖到另一个插销即可连线（同类型才能连）。左侧指令随节点参数实时重编译。
    </div>

    <FlareCard Style="margin-top:12px">
        <div style="display:flex; align-items:center; gap:10px;">
            <div class="solstice-card-title" style="margin:0;">喂给 KismetGen 的节点 JSON</div>
        </div>
        <pre style="margin:10px 0 0; padding:12px; border-radius:10px; overflow:auto; max-height:220px;
                    background:var(--flare-color-surface-container-high); font-size:12.5px;">@NodesJson</pre>
        <div class="solstice-note" style="margin-top:10px;">
            保存成 nodes.json，然后：<code>KismetGen --json nodes.json &lt;asset&gt; &lt;usmap&gt; &lt;function&gt; &lt;out&gt;</code>
        </div>
    </FlareCard>
</div>

<style>
    .pin {
        display:inline-block; width:12px; height:12px; border-radius:50%; flex:none;
        cursor:crosshair; border:2px solid transparent;
    }
    .pin:hover { transform:scale(1.3); }
    .pin-exec { background:#e8def8; border-color:#6750a4; }
    .pin-int { background:#b2f1c5; border-color:#2e6c47; }
    .pin-bool { background:#ffdea6; border-color:#7d5700; }
    .pin-object { background:#cde5ff; border-color:#00639b; }
</style>

@code {
    private const int RowHeight = 96;

    private sealed record UiPin(string Id, string Label, PinType Type);
    private sealed record UiNode(int Id, string Title, List<UiPin> Inputs, List<UiPin> Outputs);
    private sealed record Connection(int FromNode, string FromPin, int ToNode, string ToPin);

    private List<UiNode> _nodes = [];
    private readonly List<Connection> _connections = [];
    private (int Node, string Pin)? _dragFrom;
    private (double X, double Y)? _dragPos;

    private string _conditionVar = "IsElite";
    private string _cardId = "CardID";
    private string _amount = "1";
    private IReadOnlyList<KismetInstruction> _instructions = [];

    protected override void OnInitialized()
    {
        _nodes =
        [
            new(0, "If", [new("in-exec", "exec", PinType.Exec), new("in-cond", "bool", PinType.Bool)],
                [new("out-exec", "exec", PinType.Exec)]),
            new(1, "Call AddIntelToCard",
                [new("in-exec", "exec", PinType.Exec), new("in-card", "CardID int", PinType.Int), new("in-amt", "amount int", PinType.Int)],
                [new("out-exec", "exec", PinType.Exec)]),
            new(2, "Return", [new("in-exec", "exec", PinType.Exec)], [])
        ];

        _connections.Add(new Connection(0, "out-exec", 1, "in-exec"));
        _connections.Add(new Connection(1, "out-exec", 2, "in-exec"));
        Recompile();
    }

    private void StartDrag(int node, string pin)
    {
        _dragFrom = (node, pin);
        _dragPos = null;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (_dragFrom is null) return;
        _dragPos = (e.OffsetX, e.OffsetY);
    }

    private void OnMouseUp()
    {
        _dragFrom = null;
        _dragPos = null;
    }

    private void EndDrag(int node, string pin)
    {
        if (_dragFrom is not { } from) return;

        _dragFrom = null;
        _dragPos = null;

        if (from.Node == node && from.Pin == pin) return;

        var a = FindPin(from.Node, from.Pin);
        var b = FindPin(node, pin);
        if (a is null || b is null || a.Type != b.Type) return;

        if (_connections.Any(c => c.FromNode == from.Node && c.FromPin == from.Pin && c.ToNode == node && c.ToPin == pin))
            return;

        _connections.Add(new Connection(from.Node, from.Pin, node, pin));
    }

    private UiPin? FindPin(int node, string pin)
    {
        var n = _nodes.FirstOrDefault(x => x.Id == node);
        if (n is null) return null;
        return n.Inputs.Concat(n.Outputs).FirstOrDefault(p => p.Id == pin);
    }

    private static int PinY(int index) => 34 + index * 22;

    private (double X, double Y) PinPoint(int node, string pin)
    {
        var n = _nodes.First(x => x.Id == node);
        var inIdx = n.Inputs.FindIndex(p => p.Id == pin);
        var outIdx = n.Outputs.FindIndex(p => p.Id == pin);
        var x = inIdx >= 0 ? 16 : 444;
        var y = node * RowHeight + PinY(Math.Max(inIdx >= 0 ? inIdx : outIdx, 0));
        return (x, y);
    }

    private static string Curve((double X, double Y) a, (double X, double Y) b)
    {
        var dx = Math.Abs(b.X - a.X) * 0.5 + 20;
        return $"M {a.X} {a.Y} C {a.X + dx} {a.Y}, {b.X - dx} {b.Y}, {b.X} {b.Y}";
    }

    private string StrokeFor(Connection c) => FindPin(c.FromNode, c.FromPin)?.Type switch
    {
        PinType.Exec => "#6750a4",
        PinType.Int => "#2e6c47",
        PinType.Bool => "#7d5700",
        _ => "#00639b"
    };

    private static string PinClass(PinType t) => t switch
    {
        PinType.Exec => "pin-exec",
        PinType.Int => "pin-int",
        PinType.Bool => "pin-bool",
        _ => "pin-object"
    };

    private void OnConditionChanged(ChangeEventArgs e) { _conditionVar = e.Value?.ToString() ?? ""; Recompile(); }
    private void OnCardIdChanged(ChangeEventArgs e) { _cardId = e.Value?.ToString() ?? ""; Recompile(); }
    private void OnAmountChanged(ChangeEventArgs e) { _amount = e.Value?.ToString() ?? ""; Recompile(); }

    private void Recompile()
    {
        var amount = int.TryParse(_amount, out var v) ? v : 0;
        var nodes = new List<KNode>
        {
            new IfNode(new LocalArg(string.IsNullOrWhiteSpace(_conditionVar) ? "Condition" : _conditionVar),
                [new CallNode("AddIntelToCard",
                    [new LocalArg(string.IsNullOrWhiteSpace(_cardId) ? "CardID" : _cardId), new IntArg(amount)])]),
            new ReturnNode()
        };
        _instructions = KismetCompiler.Compile(nodes);
    }

    /// <summary>
    /// 由页面上的节点生成 KismetGen 的 JSON。
    /// 约定：If 之后的节点都算它的 then 体。
    /// </summary>
    private string NodesJson
    {
        get
        {
            var items = new List<string>();
            for (var i = 0; i < _nodes.Count; i++)
            {
                var node = _nodes[i];
                if (node.Title == "If")
                {
                    var body = _nodes.Skip(i + 1).Select(RenderNode).OfType<string>().ToList();
                    items.Add($$"""{ "kind": "if", "cond": { "var": "{{_conditionVar}}" }, "then": [ {{string.Join(", ", body)}} ] }""");
                    break;
                }

                var single = RenderNode(node);
                if (single is not null)
                {
                    items.Add(single);
                }
            }

            return "{\n  \"nodes\": [\n    " + string.Join(",\n    ", items) + "\n  ]\n}";
        }
    }

    private string? RenderNode(UiNode node) => node.Title switch
    {
        "If" => null,
        "Return" => "{ \"kind\": \"return\" }",
        _ when node.Title.StartsWith("Call") =>
            $"{{ \"kind\": \"context-call\", \"object\": \"{_cardId}\", \"function\": \"AddIntelToCard\", \"args\": [ {{ \"int\": {_amount} }} ] }}",
        _ => null
    };

    private void AddAssignNode()
    {
        var id = _nodes.Count == 0 ? 0 : _nodes.Max(n => n.Id) + 1;
        _nodes.Add(new UiNode(id, $"Set {_conditionVar}",
            [new($"in{id}", "exec", PinType.Exec)],
            [new($"out{id}", "exec", PinType.Exec)]));
        Recompile();
    }

    private void AddCallNode()
    {
        var id = _nodes.Count == 0 ? 0 : _nodes.Max(n => n.Id) + 1;
        _nodes.Add(new UiNode(id, "Call AddIntelToCard",
            [new($"in{id}", "exec", PinType.Exec), new($"amt{id}", "amount int", PinType.Int)],
            [new($"out{id}", "exec", PinType.Exec)]));
        Recompile();
    }

    private void AddReturnNode()
    {
        var id = _nodes.Count == 0 ? 0 : _nodes.Max(n => n.Id) + 1;
        _nodes.Add(new UiNode(id, "Return", [new($"in{id}", "exec", PinType.Exec)], []));
        Recompile();
    }

    private void RemoveLastNode()
    {
        if (_nodes.Count == 0)
        {
            return;
        }

        var last = _nodes[^1].Id;
        _nodes.RemoveAt(_nodes.Count - 1);
        _connections.RemoveAll(c => c.FromNode == last || c.ToNode == last);
        Recompile();
    }

    private static string OpcodeColor(string opcode) => opcode switch
    {
        "EX_Jump" or "EX_JumpIfNot" or "EX_Return" or "EX_EndOfScript" => "var(--flare-color-tertiary)",
        "EX_FinalFunction" or "EX_EndFunctionParms" => "var(--flare-color-primary)",
        _ => "var(--flare-color-on-surface)"
    };
}
