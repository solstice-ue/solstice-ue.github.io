@page "/"
@using Solstice.Core.AssetRegistry
@using Solstice.Core.IO
@inject IJSRuntime JS

<PageTitle>Solstice · Bin 修改</PageTitle>

@if (!_loaded)
{
    <div class="solstice-drop" @ref="_zoneRef">
        <div class="solstice-drop-glyph">⇩</div>
        <div class="solstice-drop-title">拖入 AssetRegistry.bin</div>
        <div class="solstice-muted">或点击选择文件 · 上限 @(MaxBytes / 1024 / 1024) MB · 只在浏览器内处理</div>
        <InputFile OnChange="OnFileSelected" class="solstice-drop-input" />
    </div>
}
else
{
    <div class="solstice-page">
        <div class="solstice-head">
            <h1 class="solstice-h1">Bin 修改</h1>
            <span class="solstice-spacer"></span>
            <FlareButton Variant="ButtonVariant.Outlined" OnClick="Reset">换个文件</FlareButton>
            <FlareButton Variant="ButtonVariant.Filled" OnClick="@(() => _addOpen = true)">
                新增卡牌条目
            </FlareButton>
        </div>

        @if (_error is not null)
        {
            <div class="solstice-alert-error"><strong>读取失败：</strong>@_error</div>
        }

        <FlareCard>
            <div class="solstice-kv">
                <div class="solstice-k">文件名</div>
                <div><code>@_fileName</code></div>

                <div class="solstice-k">大小</div>
                <div>@FormatSize(_size)</div>

                <div class="solstice-k">SHA-256</div>
                <div class="solstice-break"><code>@_sha256</code></div>
            </div>
        </FlareCard>

        @if (_header is not null)
        {
            <FlareCard Style="margin-top:16px">
                @if (_header.GuidMatches)
                {
                    <div class="solstice-ok">✓ 文件标识匹配 UE 的 AssetRegistry 现代格式</div>
                }
                else
                {
                    <div class="solstice-bad">✗ 文件标识不匹配，可能不是 AssetRegistry.bin，或是更老的格式</div>
                }

                <div class="solstice-kv">
                    <div class="solstice-k">GUID</div>
                    <div><code>@_header.GuidHex</code></div>

                    <div class="solstice-k">version</div>
                    <div>
                        <code>@_header.Version</code>
                        @if (_header.Version == 21)
                        {
                            <span class="solstice-chip">与 KARDS 实测样本一致</span>
                        }
                    </div>

                    <div class="solstice-k">bFilterEditorOnly</div>
                    <div><code>@_header.FilterEditorOnly</code></div>
                </div>

                <div class="solstice-note">
                    资产数组、name 表、FStore 与依赖节点<strong>尚未解析</strong>——要等既有库移植进 WASM（路线图 Phase 0）。
                </div>
            </FlareCard>
        }

        <FlareCard Style="margin-top:16px">
            <div class="solstice-card-title">样本事实</div>
            <div class="solstice-kv">
                <div class="solstice-k">AssetRegistry.bin</div>
                <div>6.2 MB · version 21 · bFilterEditorOnly = 1</div>

                <div class="solstice-k">Blueprints</div>
                <div>2137 个 <code>.uasset</code> + 2137 个 <code>.uexp</code> · 24.5 MB</div>

                <div class="solstice-k">卡牌资产</div>
                <div>2019 个：<code>card_unit</code> 1023、<code>card_event</code> 785、<code>card_location</code> 179、<code>card_wildcard</code> 24</div>
            </div>
        </FlareCard>
    </div>
}

<FlareDialog @bind-Visible="_addOpen" Title="新增卡牌条目">
    <ChildContent>
        <p class="solstice-muted" style="margin-top:0">
            首期只支持添加卡牌资产，命名规律 <code>card_&lt;类型&gt;_&lt;slug&gt;</code>。
        </p>

        <div class="solstice-form">
            <FlareSelect Label="国家" @bind-Value="_nation" Items="Nations" />
            <FlareTextField Label="系列" @bind-Value="_set" />
            <FlareSelect Label="类型" @bind-Value="_kind" Items="Kinds" />
            <FlareTextField Label="卡牌名（不含前缀）" @bind-Value="_slug" />
        </div>

        <div class="solstice-preview">
            <div><span class="solstice-k">资产名</span><code>@PreviewAssetName</code></div>
            <div><span class="solstice-k">PackagePath</span><code>@PreviewPackagePath</code></div>
            <div><span class="solstice-k">ObjectPath</span><code>@PreviewObjectPath</code></div>
        </div>

        <div class="solstice-note">
            PackagePath 由导出目录映射为 <code>/Game/Blueprints/…</code> <strong>推断</strong>而来，尚未用真实样本实测确认。
        </div>
    </ChildContent>

    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _addOpen = false)">取消</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" OnClick="RequestWrite">下一步</FlareButton>
    </ActionsContent>
</FlareDialog>

<FlareDialog @bind-Visible="_confirmOpen" Title="确认写入">
    <ChildContent>
        <div class="solstice-kv">
            <div class="solstice-k">新增</div><div>@_pendingAdd</div>
            <div class="solstice-k">修改</div><div>0</div>
            <div class="solstice-k">删除</div><div>0</div>
        </div>

        <div class="solstice-preview" style="margin-top:12px">
            <div><span class="solstice-k">ObjectPath</span><code>@PreviewObjectPath</code></div>
        </div>

        <div class="solstice-note">
            <strong>写入尚未实现。</strong>接入解析器后，这里会写出新文件并读回校验；
            输出字节与原文件不同，不会覆盖输入。
        </div>
    </ChildContent>

    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _confirmOpen = false)">取消</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" Disabled="true">写入（未实现）</FlareButton>
    </ActionsContent>
</FlareDialog>

@code {
    private const long MaxBytes = 64L * 1024 * 1024;

    private static readonly string[] Nations =
    [
        "USA", "Soviet", "Germany", "Japan", "Britain", "Italy", "France",
        "Finland", "Poland", "ANZAC", "Neutral"
    ];

    private static readonly string[] Kinds = ["events", "units", "locations", "specialCards"];

    private ElementReference _zoneRef;
    private bool _loaded;

    private string? _fileName;
    private long _size;
    private string? _sha256;
    private AssetRegistryHeader? _header;
    private string? _error;

    private bool _addOpen;
    private bool _confirmOpen;
    private int _pendingAdd;

    private string _nation = "USA";
    private string _set = "Base";
    private string _kind = "units";
    private string _slug = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded)
        {
            await JS.InvokeVoidAsync("solsticeDrop.attach", _zoneRef);
        }
    }

    private static string KindPrefix(string kind) => kind switch
    {
        "events" => "event",
        "units" => "unit",
        "locations" => "location",
        _ => "special"
    };

    private string PreviewAssetName
    {
        get
        {
            var slug = string.IsNullOrWhiteSpace(_slug) ? "<name>" : _slug.Trim();
            return $"card_{KindPrefix(_kind)}_{slug}";
        }
    }

    private string PreviewPackagePath
    {
        get
        {
            var set = string.IsNullOrWhiteSpace(_set) ? "<set>" : _set.Trim().Trim('/');
            return $"/Game/Blueprints/Cards/{_nation}/{set}/{_kind}";
        }
    }

    private string PreviewObjectPath => $"{PreviewPackagePath}/{PreviewAssetName}.{PreviewAssetName}";

    private void RequestWrite()
    {
        _pendingAdd = 1;
        _addOpen = false;
        _confirmOpen = true;
    }

    private void Reset()
    {
        _loaded = false;
        _fileName = null;
        _sha256 = null;
        _header = null;
        _error = null;
        _size = 0;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _header = null;

        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MaxBytes))
            using (var buffer = new MemoryStream())
            {
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }

            _fileName = file.Name;
            _size = bytes.LongLength;
            _sha256 = FileFingerprint.Sha256(bytes);
            _loaded = true;

            if (!AssetRegistryHeaderReader.TryRead(bytes, out var header, out var error))
            {
                _error = error;
                return;
            }

            _header = header;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loaded = true;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F2} MB"
    };
}
