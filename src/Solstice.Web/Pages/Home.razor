@page "/"
@using Solstice.Core.AssetRegistry
@using Solstice.Core.IO
@inject IJSRuntime JS

<PageTitle>Solstice · Bin 修改</PageTitle>

@if (!_loaded)
{
    <div class="solstice-drop" @ref="_zoneRef">
        <div class="solstice-drop-glyph">⇩</div>
        <div class="solstice-drop-title">拖入 AssetRegistry.bin</div>
        <div class="solstice-muted">或点击选择文件 · 上限 @(MaxBytes / 1024 / 1024) MB · 只在浏览器内处理</div>
        <InputFile OnChange="OnFileSelected" class="solstice-drop-input" />
    </div>
}
else
{
    <div class="solstice-page">
        <div class="solstice-head">
            <h1 class="solstice-h1">Bin 修改</h1>
            <span class="solstice-spacer"></span>
            <FlareButton Variant="ButtonVariant.Outlined" OnClick="Reset">换个文件</FlareButton>
            <FlareButton Variant="ButtonVariant.Outlined" OnClick="Export" Disabled="@(_doc is null)">
                导出 bin
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Filled" OnClick="@(() => _addOpen = true)" Disabled="@(_doc is null)">
                新增卡牌
            </FlareButton>
        </div>

        @if (_message is not null)
        {
            <div class="solstice-alert-ok">@_message</div>
        }

        @if (_error is not null)
        {
            <div class="solstice-alert-error"><strong>读取失败：</strong>@_error</div>
        }

        <FlareCard>
            <div class="solstice-kv">
                <div class="solstice-k">文件</div>
                <div><code>@_fileName</code> <span class="solstice-muted">@FormatSize(_size)</span></div>

                <div class="solstice-k">SHA-256</div>
                <div class="solstice-break"><code>@_sha256</code></div>

                @if (_header is not null)
                {
                    <div class="solstice-k">格式</div>
                    <div>
                        version <code>@_header.Version</code>
                        @if (_header.GuidMatches)
                        {
                            <span class="solstice-chip">标识匹配</span>
                        }
                        else
                        {
                            <span class="solstice-chip solstice-chip-bad">标识不匹配</span>
                        }
                    </div>
                }

                <div class="solstice-k">资产总数</div>
                <div>
                    <strong>@_total</strong>
                    <span class="solstice-muted">· 解析 @_parseMs ms</span>
                    @if (_addedCount > 0)
                    {
                        <span class="solstice-chip">本次新增 @_addedCount</span>
                    }
                </div>
            </div>
        </FlareCard>

        <FlareCard Style="margin-top:16px">
            <div class="solstice-toolbar">
                <FlareTextField Label="搜索 ObjectPath / 类名" @bind-Value="_search" />
                <span class="solstice-spacer"></span>
                <span class="solstice-muted">
                    匹配 @_matchCount 条 · 显示前 @DisplayLimit 条
                </span>
            </div>

            <div class="solstice-grid-wrap">
                <table class="solstice-grid">
                    <thead>
                        <tr>
                            <th>ObjectPath</th>
                            <th style="width:180px">AssetClass</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _visible)
                        {
                            <tr>
                                <td><code>@e.ObjectPath</code></td>
                                <td>@e.AssetClass</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_matchCount > DisplayLimit)
            {
                <div class="solstice-note">还有 @(_matchCount - DisplayLimit) 条未显示，用搜索缩小范围。</div>
            }
        </FlareCard>
    </div>
}

<FlareDialog @bind-Visible="_addOpen" Title="新增卡牌">
    <ChildContent>
        <p class="solstice-muted" style="margin-top:0">
            命名规律 <code>card_&lt;类型&gt;_&lt;slug&gt;</code>，会立刻出现在列表里。
        </p>

        <div class="solstice-form">
            <FlareSelect Label="国家" @bind-Value="_nation" Items="Nations" />
            <FlareTextField Label="系列" @bind-Value="_set" />
            <FlareSelect Label="类型" @bind-Value="_kind" Items="Kinds" />
            <FlareTextField Label="卡牌名（不含前缀）" @bind-Value="_slug" />
        </div>

        <div class="solstice-preview">
            <div><span class="solstice-k">资产名</span><code>@PreviewAssetName</code></div>
            <div><span class="solstice-k">PackagePath</span><code>@PreviewPackagePath</code></div>
            <div><span class="solstice-k">ObjectPath</span><code>@PreviewObjectPath</code></div>
        </div>

        @if (_addError is not null)
        {
            <div class="solstice-alert-error" style="margin-top:12px">@_addError</div>
        }
    </ChildContent>

    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => _addOpen = false)">取消</FlareButton>
        <FlareButton Variant="ButtonVariant.Filled" OnClick="ConfirmAdd">添加</FlareButton>
    </ActionsContent>
</FlareDialog>

@code {
    private const long MaxBytes = 64L * 1024 * 1024;
    private const int DisplayLimit = 200;

    private static readonly string[] Nations =
    [
        "USA", "Soviet", "Germany", "Japan", "Britain", "Italy", "France",
        "Finland", "Poland", "ANZAC", "Neutral"
    ];

    private static readonly string[] Kinds = ["events", "units", "locations", "specialCards"];

    private ElementReference _zoneRef;
    private bool _loaded;

    private string? _fileName;
    private long _size;
    private string? _sha256;
    private AssetRegistryHeader? _header;
    private string? _error;
    private string? _message;
    private long _parseMs;

    private AssetRegistryDocument? _doc;
    private AssetEntry[] _entries = [];
    private int _total;
    private int _addedCount;

    private string _search = "";
    private int _matchCount;
    private IReadOnlyList<AssetEntry> _visible = [];

    private bool _addOpen;
    private string? _addError;

    private string _nation = "USA";
    private string _set = "Base";
    private string _kind = "units";
    private string _slug = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded)
        {
            await JS.InvokeVoidAsync("solsticeDrop.attach", _zoneRef);
        }
    }

    private static string KindPrefix(string kind) => kind switch
    {
        "events" => "event",
        "units" => "unit",
        "locations" => "location",
        _ => "special"
    };

    private string PreviewAssetName
    {
        get
        {
            var slug = string.IsNullOrWhiteSpace(_slug) ? "<name>" : _slug.Trim();
            return $"card_{KindPrefix(_kind)}_{slug}";
        }
    }

    private string PreviewPackagePath
    {
        get
        {
            var set = string.IsNullOrWhiteSpace(_set) ? "<set>" : _set.Trim().Trim('/');
            return $"/Game/Blueprints/Cards/{_nation}/{set}/{_kind}";
        }
    }

    private string PreviewObjectPath => $"{PreviewPackagePath}/{PreviewAssetName}.{PreviewAssetName}";

    private void RefreshView()
    {
        var query = _search?.Trim() ?? "";
        IEnumerable<AssetEntry> filtered = _entries;

        if (query.Length > 0)
        {
            filtered = _entries.Where(e =>
                e.ObjectPath.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                e.AssetClass.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        var matches = filtered as IReadOnlyCollection<AssetEntry> ?? filtered.ToArray();
        _matchCount = matches.Count;
        _visible = matches.Take(DisplayLimit).ToArray();
    }

    private void Reset()
    {
        _loaded = false;
        _doc = null;
        _entries = [];
        _visible = [];
        _fileName = null;
        _sha256 = null;
        _header = null;
        _error = null;
        _message = null;
        _search = "";
        _addedCount = 0;
        _total = 0;
        _size = 0;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _message = null;
        _header = null;

        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MaxBytes))
            using (var buffer = new MemoryStream())
            {
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }

            _fileName = file.Name;
            _size = bytes.LongLength;
            _sha256 = FileFingerprint.Sha256(bytes);
            _loaded = true;

            AssetRegistryHeaderReader.TryRead(bytes, out var header, out _);
            _header = header;

            var sw = System.Diagnostics.Stopwatch.StartNew();
            _doc = AssetRegistryDocument.Load(bytes);
            _entries = _doc.GetEntries().ToArray();
            sw.Stop();
            _parseMs = sw.ElapsedMilliseconds;

            _total = _entries.Length;
            _addedCount = 0;
            RefreshView();
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name + ": " + ex.Message;
            _loaded = true;
        }
    }

    private void ConfirmAdd()
    {
        _addError = null;

        if (string.IsNullOrWhiteSpace(_slug))
        {
            _addError = "卡牌名不能为空。";
            return;
        }

        if (_doc is null)
        {
            _addError = "尚未载入文件。";
            return;
        }

        var packagePath = PreviewPackagePath;
        var assetName = PreviewAssetName;

        var added = _doc.AddAsset(packagePath, assetName, _assetClassForCard);
        if (!added)
        {
            _addError = $"已存在同名资产：{assetName}";
            return;
        }

        _entries = _doc.GetEntries().ToArray();
        _total = _entries.Length;
        _addedCount++;
        _search = assetName;
        RefreshView();

        _addOpen = false;
        _message = $"已添加 {assetName}（共 {_total} 条）。记得导出——本次改动只在内存里。";
    }

    private async Task Export()
    {
        if (_doc is null)
        {
            return;
        }

        try
        {
            var bytes = _doc.Save();
            var name = (_fileName ?? "AssetRegistry.bin").Replace(".bin", "") + ".edited.bin";
            await JS.InvokeVoidAsync("solsticeDownload", name, Convert.ToBase64String(bytes));
            _message = $"已导出 {name}（{FormatSize(bytes.LongLength)}）。写回是语义级的，字节与原文件不同。";
        }
        catch (Exception ex)
        {
            _error = "导出失败：" + ex.Message;
        }
    }

    // 卡牌资产的 AssetClass 尚未用真实样本核对，先按 Blueprint 处理，
    // 并在 UI 与文档里标注为待确认。
    private const string _assetClassForCard = "Blueprint";

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F2} MB"
    };
}
