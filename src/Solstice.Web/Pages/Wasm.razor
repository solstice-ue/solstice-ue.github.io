@page "/wasm"
@using Microsoft.AspNetCore.Components.Forms
@using Solstice.Core.Kismet
@using Solstice.Core.Pak
@inject IJSRuntime JS

<PageTitle>Solstice · 生成</PageTitle>

<div class="solstice-page" style="max-width:none">
    <div class="solstice-head">
        <h1 class="solstice-h1">蓝图生成</h1>
        <span class="solstice-spacer"></span>
        <span class="solstice-muted">@_status</span>
    </div>

    <FlareCard>
        <div class="solstice-card-title">1. 载入资产</div>
        <div style="display:flex; gap:16px; flex-wrap:wrap; margin-top:10px;">
            <label class="w-file"><span>.uasset</span><InputFile OnChange="OnUassetAsync" accept=".uasset" /></label>
            <label class="w-file"><span>.uexp</span><InputFile OnChange="OnUexpAsync" accept=".uexp" /></label>
            <label class="w-file"><span>.usmap</span><InputFile OnChange="OnUsmapAsync" accept=".usmap" /></label>
            <label class="w-file"><span>函数表（可选）</span><InputFile OnChange="OnCatalogAsync" accept=".json" /></label>
            <FlareButton Variant="ButtonVariant.Filled" OnClick="LoadAsync" Disabled="@(!_ready)">载入</FlareButton>
        </div>
    </FlareCard>

    @if (_ws is not null)
    {
        <FlareCard Style="margin-top:12px">
            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                <span class="solstice-card-title" style="margin:0;">2. 函数</span>
                <select class="w-select" value="@_selected" @onchange="OnFunctionChanged">
                    @foreach (var f in _functions) { <option value="@f">@f</option> }
                </select>
                <span class="solstice-muted">变量 @_variables.Count · 可导入函数 @_importChoices.Count</span>
            </div>
        </FlareCard>

        <FlareCard Style="margin-top:12px">
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <span class="solstice-card-title" style="margin:0;">3. 节点</span>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("get"))">+ 读变量</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("const"))">+ 常量</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("assign"))">+ 赋值</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("assign-bool"))">+ 布尔赋值</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("call"))">+ 调用</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("if"))">+ 条件</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("loop"))">+ 循环</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("end"))">+ 块结束</FlareButton>
                <FlareButton Variant="ButtonVariant.Outlined" OnClick="@(() => Add("return"))">+ 返回</FlareButton>
            </div>

            <div class="w-canvas" style="height:@(_specs.Count * RowHeight)px; margin-top:10px;"
                 @onmousemove="OnMouseMove" @onmouseup="OnMouseUp" @onmouseleave="OnMouseUp">
                <svg width="@CanvasWidth" height="@(_specs.Count * RowHeight)"
                     style="position:absolute; left:0; top:0; pointer-events:none;">
                    @foreach (var link in _dataLinks)
                    {
                        var a = OutputPoint(link.From, 0, OutputsOf(_specs[link.From]).Count);
                        var b = InputPoint(link.To, link.ToPin);
                        <path d="@Curve(a, b)" stroke="#2e6c47" stroke-width="2" fill="none" />
                    }
                    @if (_dragFrom is { } df && _dragPos is { } dp)
                    {
                        <path d="@Curve(OutputPoint(df.Row, df.Index, OutputsOf(_specs[df.Row]).Count), dp)"
                              stroke="var(--flare-color-primary)" stroke-width="2" stroke-dasharray="4 3" fill="none" />
                    }
                </svg>

                @for (var i = 0; i < _specs.Count; i++)
                {
                    var row = i;
                    var spec = _specs[row];
                    var ins = InputsOf(spec);
                    var outs = OutputsOf(spec);

                    var depth = DepthOf(row);
                    if (spec.Kind == "end") { depth = Math.Max(0, depth - 1); }
                    var indent = depth * 24;

                    <div class="w-node" style="top:@(row * RowHeight)px; left:@(indent)px; width:@(CanvasWidth - indent)px;">
                        @for (var k = 0; k < ins.Count; k++)
                        {
                            var pin = ins[k];
                            var idx = k;
                            <span class="w-pin w-pin-in" style="left:4px; top:@(PinY(k, ins.Count))px;"
                                  title="数据输入：@pin.Label"
                                  @onmousedown:preventDefault="true"
                                  @onmouseup="@(() => EndDrag(row, pin.Id, true))"></span>
                            <span class="w-pin-lbl" style="left:20px; top:@(PinY(k, ins.Count) + 1)px;">@pin.Label</span>
                        }

                        <div class="w-node-body">
                            <select class="w-select-sm" value="@spec.Kind" @onchange="@(e => ChangeKind(spec, e))">
                                <option value="get">读变量</option>
                                <option value="const">常量</option>
                                <option value="assign">赋值</option>
                                <option value="assign-bool">布尔赋值</option>
                                <option value="call">调用</option>
                                <option value="if">条件</option>
                                <option value="loop">循环</option>
                                <option value="end">块结束</option>
                                <option value="return">返回</option>
                            </select>

                            @if (spec.Kind is "get" or "assign" or "assign-bool" or "if" or "loop")
                            {
                                <select class="w-select-sm" value="@spec.Var"
                                        @onchange="@(e => { spec.Var = e.Value?.ToString() ?? ""; Refresh(); })">
                                    @foreach (var v in _variables) { <option value="@v">@v</option> }
                                </select>
                            }

                            @if (spec.Kind is "const" or "assign")
                            {
                                <input class="w-input w-num" type="number" @bind="spec.Value" @bind:after="Refresh" />
                            }

                            @if (spec.Kind == "assign-bool")
                            {
                                <select class="w-select-sm" value="@spec.BoolValue.ToString()"
                                        @onchange="@(e => { spec.BoolValue = e.Value?.ToString() == "True"; Refresh(); })">
                                    <option value="True">true</option>
                                    <option value="False">false</option>
                                </select>
                            }

                            @if (spec.Kind == "call")
                            {
                                <select class="w-select-sm w-wide" value="@spec.Function"
                                        @onchange="@(e => { spec.Function = e.Value?.ToString() ?? ""; Refresh(); })">
                                    <option value="">（选择函数）</option>
                                    @foreach (var f in _importChoices) { <option value="@f">@f</option> }
                                    @foreach (var f in _localChoices) { <option value="@f">@f（本资产）</option> }
                                </select>
                            }



                            <span class="solstice-spacer"></span>
                            <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => RemoveAt(row))">删除</FlareButton>
                        </div>

                        @for (var k = 0; k < outs.Count; k++)
                        {
                            var idx = k;
                            <span class="w-pin w-pin-out" style="right:4px; top:@(PinY(k, outs.Count))px;"
                                  title="数据输出：拖到某个输入端"
                                  @onmousedown:preventDefault="true"
                                  @onmousedown="@(() => StartDrag(row, idx))"></span>
                            <span class="w-pin-lbl-out" style="right:20px; top:@(PinY(k, outs.Count) + 1)px;">@outs[k].Label</span>
                        }
                    </div>
                }
            </div>

            <div class="solstice-note" style="margin-top:8px;">
                <b>执行流 = 节点从上到下的顺序</b>（条件/循环之后的节点是它的体内）。
                插销只承载<b>数据</b>：从右侧输出点拖到左侧输入点即可把值接进去，未连线的输入用自己的下拉/数值。
            </div>
        </FlareCard>

        <div style="display:grid; grid-template-columns:minmax(320px,1fr) minmax(320px,1fr); gap:16px; margin-top:12px;">
            <FlareCard>
                <div class="solstice-card-title">4. 实时预览 · @_opcodes.Count 条 / @_byteCount 字节</div>
                <div class="w-code">
                    @for (var i = 0; i < _opcodes.Count; i++)
                    {
                        <div><span style="opacity:.45">@i.ToString("000")</span>  @_opcodes[i]</div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_hex))
                {
                    <pre class="w-hex">@_hex</pre>
                }
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div style="margin-top:8px; color:var(--flare-color-error); white-space:pre-wrap; font-size:12.5px;">@_error</div>
                }
            </FlareCard>

            <FlareCard>
                <div class="solstice-card-title">5. 导出</div>
                <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
                    <FlareButton Variant="ButtonVariant.Filled" OnClick="Generate">写回资产</FlareButton>
                    <FlareButton Variant="ButtonVariant.Outlined" OnClick="DownloadAssetsAsync" Disabled="@(_saved is null)">下载 uasset/uexp</FlareButton>
                </div>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <span class="solstice-muted">pak 内路径</span>
                    <input class="w-input" style="max-width:340px;" @bind="_contentPath" @bind:event="oninput"
                           placeholder="Blueprints/Cards/card_brawl_test1" />
                    <FlareButton Variant="ButtonVariant.Filled" OnClick="DownloadPakAsync" Disabled="@(_saved is null)">下载 .pak</FlareButton>
                </div>
                <div class="solstice-note" style="margin-top:8px; font-size:12px;">
                    mount point <code>../../../kards/Content/</code>，条目名「路径 + .uasset/.uexp」。
                    @if (_saved is not null)
                    {
                        <span>已写出 uasset @_saved.UAsset.Length B / uexp @_saved.UExp.Length B。</span>
                    }
                </div>
            </FlareCard>
        </div>
    }
</div>

<style>
    .w-file { display:flex; flex-direction:column; gap:6px; font-size:13px; }
    .w-select { padding:8px 12px; border-radius:8px; border:1px solid var(--flare-color-outline);
                background:var(--flare-color-surface-container-low); color:inherit; min-width:280px; }
    .w-select-sm { padding:4px 8px; border-radius:6px; border:1px solid var(--flare-color-outline);
                   background:var(--flare-color-surface-container-low); color:inherit; font-size:12px; }
    .w-select-sm.w-wide { min-width:170px; }
    .w-input { padding:4px 8px; border-radius:6px; border:1px solid var(--flare-color-outline);
               background:var(--flare-color-surface-container-low); color:inherit; font-size:12.5px; }
    .w-input.w-num { width:74px; }
    .w-canvas { position:relative; overflow:auto; width:@(CanvasWidth)px; max-width:100%;
                user-select:none; -webkit-user-select:none; }
    .w-node { position:absolute; left:0; width:@(CanvasWidth)px; height:@(RowHeight - 8)px;
              border:1px solid var(--flare-color-outline-variant); border-radius:12px;
              background:var(--flare-color-surface-container-low); }
    .w-node-body { position:absolute; left:52px; right:34px; top:0; bottom:0;
                   display:flex; align-items:center; gap:8px; }
    .w-pin { position:absolute; width:13px; height:13px; border-radius:50%; cursor:crosshair; }
    .w-pin-in { background:#cde5ff; border:2px solid #00639b; }
    .w-pin-out { background:#b2f1c5; border:2px solid #2e6c47; }
    .w-pin:hover { transform:scale(1.35); }
    .w-pin-lbl, .w-pin-lbl-out { position:absolute; font-size:11px; opacity:.6; pointer-events:none; }
    .w-hex { margin:8px 0 0; padding:8px; border-radius:6px; max-height:120px; overflow:auto;
             background:var(--flare-color-surface-container-high); font-size:11px; word-break:break-all; }
    .w-code { margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.7;
              max-height:320px; overflow:auto; }
</style>

@code {
    private const int RowHeight = 62;
    private const int CanvasWidth = 900;

    private sealed class NodeSpec
    {
        public string Kind = "assign";
        public string Var = "";
        public int Value = 1;
        public bool BoolValue = true;
        public string Function = "";
    }

    private sealed record DataLink(int From, string FromPin, int To, string ToPin);

    private byte[]? _uasset, _uexp, _usmap, _catalogJson;
    private KismetWorkspace? _ws;
    private List<string> _functions = [];
    private List<string> _variables = [];
    private List<string> _importChoices = [];
    private List<string> _localChoices = [];
    private string _selected = "";

    private List<NodeSpec> _specs = [];
    private readonly List<DataLink> _dataLinks = [];

    private (int Row, int Index, string Pin)? _dragFrom;
    private (double X, double Y)? _dragPos;

    private List<string> _opcodes = [];
    private string _hex = "";
    private int _byteCount;
    private KismetWorkspace.SavedAsset? _saved;
    private string _contentPath = "";

    private string _status = "等待文件";
    private string _error = "";

    private bool _ready => _uasset is not null && _uexp is not null && _usmap is not null;

    // ---- 节点形状 ----

    /// <summary>调用节点的签名（没载函数表时返回 null）。</summary>
    private FunctionSignature? SigOf(NodeSpec s)
        => s.Kind == "call" && !string.IsNullOrEmpty(s.Function) ? _ws?.SignatureOf(s.Function) : null;

    private List<(string Id, string Label)> InputsOf(NodeSpec s)
    {
        switch (s.Kind)
        {
            case "assign" or "assign-bool": return [("value", "值")];
            case "if" or "loop": return [("cond", "条件")];
            case "call":
            {
                var list = new List<(string, string)>();
                var sig = SigOf(s);

                // 非静态函数需要一个对象作为上下文
                if (sig is not null && !sig.IsStatic) { list.Add(("obj", "对象")); }

                var count = sig?.Inputs.Count ?? 1;
                for (var i = 0; i < count; i++)
                {
                    var p = sig is null ? null : sig.Inputs[i];
                    list.Add(($"arg{i}", p is null ? "参数" : p.Name));
                }

                return list;
            }
            default: return [];
        }
    }

    private List<(string Id, string Label)> OutputsOf(NodeSpec s)
    {
        switch (s.Kind)
        {
            case "get" or "const": return [("val", "值")];
            case "call":
            {
                var sig = SigOf(s);
                if (sig is null) { return []; }
                return sig.Outputs.Select((p, i) => ($"ret{i}", p.Name)).ToList();
            }
            default: return [];
        }
    }

    /// <summary>某个源节点能提供的数据。</summary>
    private KArg? ArgOf(int sourceRow)
    {
        var src = _specs[sourceRow];
        return src.Kind switch
        {
            "get" => new LocalArg(src.Var),
            "const" => new IntArg(src.Value),
            _ => null
        };
    }

    private static int PinY(int index, int count)
        => count <= 1 ? (RowHeight - 8) / 2 - 6 : 12 + index * 22;

    private (double X, double Y) InputPoint(int row, string pinId)
    {
        var ins = InputsOf(_specs[row]);
        var idx = Math.Max(ins.FindIndex(p => p.Id == pinId), 0);
        return (DepthOf(row) * 24 + 10, row * RowHeight + PinY(idx, ins.Count) + 6);
    }

    private (double X, double Y) OutputPoint(int row, int index, int count)
        => (CanvasWidth - 10, row * RowHeight + PinY(index, count) + 6);

    private static string Curve((double X, double Y) a, (double X, double Y) b)
    {
        var dx = Math.Max(Math.Abs(b.X - a.X) * 0.45, 50);
        return $"M {a.X} {a.Y} C {a.X + dx} {a.Y}, {b.X - dx} {b.Y}, {b.X} {b.Y}";
    }

    // ---- 资产 ----

    private async Task<byte[]> ReadAsync(IBrowserFile file)
    {
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 512L * 1024 * 1024).CopyToAsync(ms);
        return ms.ToArray();
    }

    private async Task OnUassetAsync(InputFileChangeEventArgs e) { _uasset = await ReadAsync(e.File); _status = $"uasset {_uasset.Length} 字节"; }
    private async Task OnUexpAsync(InputFileChangeEventArgs e) { _uexp = await ReadAsync(e.File); _status = $"uexp {_uexp.Length} 字节"; }
    private async Task OnUsmapAsync(InputFileChangeEventArgs e) { _usmap = await ReadAsync(e.File); _status = $"usmap {_usmap.Length} 字节"; }

    private async Task OnCatalogAsync(InputFileChangeEventArgs e)
    {
        _catalogJson = await ReadAsync(e.File);
        _status = $"函数表 {_catalogJson.Length} 字节";
    }

    private void LoadAsync()
    {
        _error = "";
        try
        {
            _ws = KismetWorkspace.Open(_uasset!, _uexp!, _usmap!, "/solstice-ws");
            _functions = _ws.Functions.ToList();
            _importChoices = _ws.FunctionImports.Keys.OrderBy(x => x, StringComparer.Ordinal).ToList();
            _localChoices = _functions.ToList();
            _selected = _functions.FirstOrDefault() ?? "";

            if (_catalogJson is { Length: > 0 })
            {
                _ws.AttachCatalog(FunctionCatalog.Load(System.Text.Encoding.UTF8.GetString(_catalogJson)));
            }

            InitializeForFunction();
            _status = _ws.Catalog is null
                ? $"已载入：{_functions.Count} 个函数 / {_importChoices.Count} 个可导入（未载函数表，调用只有通用参数）"
                : $"已载入：{_functions.Count} 个函数 / {_importChoices.Count} 个可导入 / 签名 {_ws.Catalog.Count} 条";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            _status = "载入失败";
        }
    }

    private void OnFunctionChanged(ChangeEventArgs e)
    {
        _selected = e.Value?.ToString() ?? "";
        InitializeForFunction();
    }

    private void InitializeForFunction()
    {
        _variables = _ws?.Variables(_selected).ToList() ?? [];
        _specs = [];
        _dataLinks.Clear();
        _saved = null;

        if (_variables.Count > 0)
        {
            _specs.Add(new NodeSpec { Kind = "assign", Var = _variables[0], Value = 5 });
        }

        _specs.Add(new NodeSpec { Kind = "return" });
        Refresh();
    }

    private void Add(string kind)
    {
        _specs.Add(new NodeSpec
        {
            Kind = kind,
            Var = _variables.FirstOrDefault() ?? "",
            Function = kind == "virtual-call"
                ? _localChoices.FirstOrDefault() ?? ""
                : _importChoices.FirstOrDefault() ?? ""
        });
        Refresh();
    }

    private void RemoveAt(int i)
    {
        if (i < 0 || i >= _specs.Count) { return; }

        _specs.RemoveAt(i);
        _dataLinks.RemoveAll(l => l.From == i || l.To == i);
        for (var k = 0; k < _dataLinks.Count; k++)
        {
            var l = _dataLinks[k];
            _dataLinks[k] = new DataLink(
                l.From > i ? l.From - 1 : l.From, l.FromPin,
                l.To > i ? l.To - 1 : l.To, l.ToPin);
        }

        Refresh();
    }

    private void ChangeKind(NodeSpec spec, ChangeEventArgs e)
    {
        spec.Kind = e.Value?.ToString() ?? "assign";
        if (spec.Kind == "call" && !_importChoices.Contains(spec.Function) && !_localChoices.Contains(spec.Function))
        {
            spec.Function = _importChoices.FirstOrDefault() ?? _localChoices.FirstOrDefault() ?? "";
        }

        Refresh();
    }

    // ---- 数据连线 ----

    private void StartDrag(int row, int index)
    {
        var outs = OutputsOf(_specs[row]);
        _dragFrom = (row, index, outs.Count > index ? outs[index].Id : "val");
        _dragPos = null;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (_dragFrom is null) { return; }
        _dragPos = (e.OffsetX, e.OffsetY);
    }

    private void OnMouseUp() => _dragFrom = null;

    private void EndDrag(int row, string pinId, bool isInput)
    {
        if (_dragFrom is not { } from) { return; }
        _dragFrom = null;
        _dragPos = null;

        if (!isInput || from.Row == row) { return; }
        if (OutputsOf(_specs[from.Row]).Count == 0) { return; }

        // 一个输入只接一条线
        _dataLinks.RemoveAll(l => l.To == row && l.ToPin == pinId);
        _dataLinks.Add(new DataLink(from.Row, from.Pin, row, pinId));
        Refresh();
    }

    /// <summary>取某个输入端的实参：有连线用源节点，没有用节点自身的下拉/数值。</summary>
    private KArg ArgFor(int row, string pinId, KArg fallback)
    {
        var link = _dataLinks.FirstOrDefault(l => l.To == row && l.ToPin == pinId);
        if (link is null) { return fallback; }

        var src = _specs[link.From];
        return src.Kind switch
        {
            "get" => new LocalArg(src.Var),
            "const" => new IntArg(src.Value),
            _ => fallback
        };
    }

    // ---- 生成 ----

    private List<KNode> BuildNodes() => BuildRange(0, out _);

    /// <summary>解析到最近的「块结束」为止；没有块结束时吃到列表末尾。</summary>
    private List<KNode> BuildRange(int start, out int next)
    {
        var nodes = new List<KNode>();
        var i = start;

        while (i < _specs.Count)
        {
            var s = _specs[i];

            if (s.Kind == "end")
            {
                next = i + 1;
                return nodes;
            }

            if (s.Kind is "if" or "loop")
            {
                var body = BuildRange(i + 1, out var after);

                var cond = ArgFor(i, "cond", new LocalArg(s.Var));
                nodes.Add(s.Kind == "if" ? new IfNode(cond, body) : new LoopNode(cond, body));
                i = after;
                continue;
            }

            var node = ToNode(s, i);
            if (node is not null) { nodes.Add(node); }
            i++;
        }

        next = i;
        return nodes;
    }

    /// <summary>该行处于第几层块内（用于缩进显示）。</summary>
    private int DepthOf(int row)
    {
        var depth = 0;
        for (var i = 0; i < row && i < _specs.Count; i++)
        {
            if (_specs[i].Kind is "if" or "loop") { depth++; }
            else if (_specs[i].Kind == "end" && depth > 0) { depth--; }
        }

        return depth;
    }

    private KNode? ToNode(NodeSpec s, int row)
    {
        switch (s.Kind)
        {
            case "get" or "const":
                return null; // 纯数据源，不产生指令
            case "assign":
                return new AssignNode(s.Var, ArgFor(row, "value", new IntArg(s.Value)));
            case "assign-bool":
                return new AssignBoolNode(s.Var, s.BoolValue);
            case "return":
                return new ReturnNode();
            case "call" when !string.IsNullOrEmpty(s.Function):
                return BuildCall(s, row);
            default:
                return null;
        }
    }

    /// <summary>
    /// 调用的指令形态由系统推断，不需要用户选：
    /// 本资产函数 → EX_LocalVirtualFunction；静态函数 → EX_FinalFunction；实例函数 → EX_Context。
    /// </summary>
    private KNode BuildCall(NodeSpec s, int row)
    {
        var sig = SigOf(s);
        var args = new List<KArg>();

        var count = sig?.Inputs.Count ?? 1;
        for (var i = 0; i < count; i++)
        {
            var pin = $"arg{i}";
            var link = _dataLinks.FirstOrDefault(l => l.To == row && l.ToPin == pin);
            var label = sig is null ? pin : sig.Inputs[i].Name;

            if (link is null)
            {
                if (sig is null) { continue; } // 没有签名时按无参处理
                throw new InvalidOperationException($"调用 {s.Function} 的参数「{label}」未连接");
            }

            args.Add(ArgOf(link.From)
                     ?? throw new InvalidOperationException($"参数「{label}」的来源不能提供值"));
        }

        if (_functions.Contains(s.Function))
        {
            return new VirtualCallNode(s.Function, args);
        }

        if (sig is not null && sig.IsStatic)
        {
            return new CallNode(s.Function, args);
        }

        var objLink = _dataLinks.FirstOrDefault(l => l.To == row && l.ToPin == "obj");
        if (objLink is null)
        {
            throw new InvalidOperationException($"调用 {s.Function} 是非静态函数，需要连接「对象」");
        }

        var obj = _specs[objLink.From];
        if (obj.Kind != "get")
        {
            throw new InvalidOperationException("「对象」只能来自「读变量」节点");
        }

        return new ContextCallNode(obj.Var, s.Function, args);
    }

    private void Refresh()
    {
        _error = "";
        _saved = null;

        if (_ws is null || string.IsNullOrEmpty(_selected)) { return; }

        try
        {
            var (ops, hex, bytes) = _ws.Preview(BuildNodes(), _selected);
            _opcodes = ops.ToList();
            _hex = hex;
            _byteCount = bytes;
        }
        catch (Exception ex)
        {
            _opcodes = [];
            _hex = "";
            _byteCount = 0;
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private void Generate()
    {
        _error = "";
        _saved = null;

        try
        {
            var (ops, hex, bytes) = _ws!.Generate(BuildNodes(), _selected);
            _opcodes = ops.ToList();
            _hex = hex;
            _byteCount = bytes;
            _saved = _ws.Save("/solstice-ws");
            _status = $"已写回：{ops.Count} 条 / {bytes} 字节";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            _status = "写回失败";
        }
    }

    private async Task DownloadAssetsAsync()
    {
        if (_saved is null) { return; }
        await JS.InvokeVoidAsync("solsticeDownload", "out.uasset", Convert.ToBase64String(_saved.UAsset));
        await JS.InvokeVoidAsync("solsticeDownload", "out.uexp", Convert.ToBase64String(_saved.UExp));
        _status = "已触发下载（out.uasset / out.uexp）";
    }

    private async Task DownloadPakAsync()
    {
        if (_saved is null) { return; }

        var path = (_contentPath ?? "").Trim().Trim('/').Replace('\\', '/');
        if (path.Length == 0)
        {
            _error = "请先填写 pak 内路径，例如 Blueprints/Cards/card_brawl_test1";
            return;
        }

        if (path.EndsWith(".uasset", StringComparison.OrdinalIgnoreCase))
        {
            path = path[..^".uasset".Length];
        }

        try
        {
            var entries = new List<PakEntry>
            {
                new($"{path}.uasset", _saved.UAsset),
                new($"{path}.uexp", _saved.UExp)
            };

            var pak = PakWriter.Build("../../../kards/Content/", entries);
            var name = Path.GetFileName(path) + ".pak";
            await JS.InvokeVoidAsync("solsticeDownload", name, Convert.ToBase64String(pak));
            _status = $"已生成 {name}（{pak.Length} 字节 / 2 条目）";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            _status = "打包失败";
        }
    }
}
